# Copy this template to .env.local on a fresh setup.
# If .env.local already exists, edit it instead of overwriting it.
# Replace USER/PASSWORD with your actual PostgreSQL credentials.
DATABASE_URL=

# Public production URL, e.g. https://your-site.onrender.com
# Used for canonical links, sitemap, and social metadata.
SITE_URL=

# Set a long, unique password. There is no built-in production default.
ADMIN_PASSWORD=

# Generate a separate signing secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
