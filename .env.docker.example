# Docker-only configuration. Copy to .env.docker and fill in the blank secrets,
# or run scripts/docker-init.mjs inside a Node container to generate them.
# This file does not replace your existing .env / .env.local configuration.
POSTGRES_USER=ahad
POSTGRES_DB=portfolio

# Use a long hexadecimal or URL-safe password (no @, :, /, #, %, or spaces).
# The setup script generates safe random values automatically.
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
# Separate random signing secret, at least 32 characters.
ADMIN_SESSION_SECRET=

# Local app: http://localhost:3000 (change this if port 3000 is in use).
APP_PORT=3000
ADMIN_COOKIE_SECURE=false

# Optional HTTPS deployment: fill these before using compose.production.yaml.
# DOMAIN must be a bare domain, e.g. portfolio.your-domain.com, not a URL.
DOMAIN=
ACME_EMAIL=
