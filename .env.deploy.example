# Copy to .env.deploy only on a trusted local machine, or set these values in
# this project's secure environment/Secrets settings. Never paste secrets in chat.
# This file is a blank template, not deployment credentials.

# Create a short-lived key: Render Dashboard > Account Settings > API Keys.
RENDER_API_KEY=

# Existing repo containing THIS complete project. Private repositories require
# your Git provider to be connected to Render with access to the repository.
DEPLOY_REPO_URL=

# A NEW hosted PostgreSQL database, e.g. a Neon Free project's direct/non-pooled
# connection URL. Keep SSL parameters. Do not use the sandbox DATABASE_URL.
DEPLOY_DATABASE_URL=

# Optional: needed only if the API key can see multiple Render workspaces.
RENDER_OWNER_ID=

# Optional: determines the requested service name; URL availability is not guaranteed.
DEPLOY_SERVICE_NAME=ahad-raza-portfolio

# Optional: leave empty to use the repository's default branch.
DEPLOY_BRANCH=
